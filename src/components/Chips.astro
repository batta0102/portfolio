---
interface Props {
  items: readonly string[];
}

const { items } = Astro.props;
---

<ul class="flex flex-wrap gap-1.5">
  {
    items.map((item) => (
      <li class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300">
        {item}
      </li>
    ))
  }
</ul>
