---
import Chips from './Chips.astro';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { projects, ui, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const label = 'mb-1.5 text-xs font-semibold tracking-wide text-slate-600 uppercase dark:text-slate-400';
---

<section id="projects" aria-labelledby="projects-title" class="py-12">
  <SectionHeading id="projects">{t.sections.projects}</SectionHeading>
  <ul class="grid items-start gap-5 md:grid-cols-2">
    {
      projects.map((p) => (
        <li>
          <article
            id={p.id}
            aria-labelledby={`${p.id}-title`}
            class="rounded-xl border border-slate-200 p-5 dark:border-slate-700"
          >
            <h3 id={`${p.id}-title`} class="text-lg font-semibold text-slate-900 dark:text-white">
              {p.name}
            </h3>
            <p class="text-sm font-medium text-teal-700 dark:text-teal-300">{p.tagline[lang]}</p>
            <p class="mt-0.5 text-sm text-slate-600 dark:text-slate-400">{p.meta[lang]}</p>
            <p class="mt-3 leading-relaxed">{p.summary[lang]}</p>

            <details class="mt-4">
              <summary class="inline-flex cursor-pointer list-none items-center gap-1 text-sm font-semibold text-teal-700 hover:underline dark:text-teal-300">
                <Icon name="chevron" class="chevron h-4 w-4 transition-transform" />
                {t.caseStudy}
                <span class="sr-only">: {p.name}</span>
              </summary>
              <div class="mt-4 space-y-4 border-t border-slate-200 pt-4 text-sm leading-relaxed dark:border-slate-700">
                <div>
                  <h4 class={label}>{t.problem}</h4>
                  <p>{p.problem[lang]}</p>
                </div>
                <div>
                  <h4 class={label}>{t.built}</h4>
                  <ul class="list-disc space-y-1 pl-5 marker:text-slate-400">
                    {p.built[lang].map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 class={label}>{t.stack}</h4>
                  <Chips items={p.stack} />
                </div>
                {p.learned && (
                  <div>
                    <h4 class={label}>{t.learned}</h4>
                    <ul class="list-disc space-y-1 pl-5 marker:text-slate-400">
                      {p.learned[lang].map((l) => (
                        <li>{l}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {p.link && (
                  <a
                    href={p.link}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-1 font-semibold text-teal-700 hover:underline dark:text-teal-300"
                  >
                    {t.viewProject}
                    <span class="sr-only">: {p.name}</span>
                    <Icon name="external" class="h-3.5 w-3.5" />
                  </a>
                )}
              </div>
            </details>
          </article>
        </li>
      ))
    }
  </ul>
</section>
